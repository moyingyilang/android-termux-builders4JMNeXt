# buildkit 配置模板：复制成 build.env 后按自己的环境改。
# 设计原则：**不含任何密钥**、**不含个人路径**，所有可变项都在这里。

# 宿主机（Termux）上的项目根目录
PROJECT_DIR="$HOME/jmc/JMComic_Next"

# 用于构建的 Linux 环境（chroot / proot / 容器）根目录
# 例：tmoe-linux 的 chroot
CHROOT_ROOT="$HOME/.local/share/tmoe-linux/containers/chroot/debian-bookworm_arm64"

# 容器内需要的 JDK 与 Gradle（写容器内路径）
CONTAINER_JDK="/opt/jdk21-linux"
CONTAINER_GRADLE="/opt/gradle-9.8.0/bin/gradle"

# Android SDK（宿主机路径；脚本会自动把它挂进容器）
ANDROID_SDK="$HOME/android-sdk"
# 注意：aapt2/apksigner 需要 glibc，容器内执行；build-tools 选**目标架构一致**的那个
AAPT2_BUILD_TOOLS="35.0.1"

# 需要挂进容器的宿主机目录（空格分隔）。默认这三样：
#   项目目录、Android SDK、~/.android（**含签名密钥，只挂载、绝不入库**）
MOUNT_DIRS="$PROJECT_DIR $ANDROID_SDK $HOME/.android"

# Android 出包：release 需要 keystore.properties（放在项目根，**不入库**）
ANDROID_RELEASE_TASKS=":app:assembleFullRelease :app:assembleLiteRelease"

# 桌面端产物目录（默认在项目 desktop/ 下）
DIST_AARCH64="$PROJECT_DIR/desktop/dist"
DIST_X64="$PROJECT_DIR/desktop/dist-x64"
DIST_WIN64="$PROJECT_DIR/desktop/dist-win64"
DIST_WINARM="$PROJECT_DIR/desktop/dist-win"
# 版本号从哪个源码路径读（相对 desktop/src/main/kotlin）
PKG_PATH="com/jmnext/desktop"

# 桌面端打包（40-package-desktop.sh）用：打包步骤按顺序执行，任一步失败即停
DESKTOP_DIR="$PROJECT_DIR/desktop"
DESKTOP_STEPS="$DESKTOP_DIR/scripts/package-linux.sh $DESKTOP_DIR/scripts/package-linux-x64.sh $DESKTOP_DIR/scripts/package-windows-x64.sh $DESKTOP_DIR/scripts/package-windows-arm64-x.sh"
